generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  GUARD
  ADMIN
}

enum UserType {
  PERSONNEL
  CIVILIAN
}

enum PermitStatus {
  APPROVED
  CANCELLED
}

enum PermitCategory {
  STANDARD
  EXTENDED
}

enum ChargeStatus {
  PENDING
  PAID
  WAIVED
}

enum VisitStatus {
  EXPECTED
  INSIDE
  EXITED
  DENIED
}

enum AuditAction {
  CREATE_PERMIT
  CANCEL_PERMIT
  GRANT_ENTRY
  DENY_ENTRY
  RECORD_EXIT
  CREATE_RESIDENT
  UPDATE_RESIDENT
  DEACTIVATE_USER
  CREATE_GATE
  UPDATE_GATE
  CREATE_GUARD
  UPDATE_GUARD
  CHANGE_PASSWORD
  CREATE_USER
  BULK_CREATE_USERS
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  role               Role
  fullName           String
  userType           UserType           @default(PERSONNEL)
  serviceNumber      String?            @unique
  mustChangePassword Boolean            @default(true)
  passwordChangedAt  DateTime?
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  resident           Resident?
  guard              Guard?
  auditLogs          AuditLog[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
}

model Resident {
  id          String   @id @default(cuid())
  userId      String   @unique
  houseNumber String
  phone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permits     Permit[]

  @@index([houseNumber])
}

model Guard {
  id             String     @id @default(cuid())
  userId         String     @unique
  assignedGateId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedGate   Gate?      @relation(fields: [assignedGateId], references: [id], onDelete: SetNull)
  entryVisits    Visit[]    @relation("entryGuard")
  exitVisits     Visit[]    @relation("exitGuard")
  audits         AuditLog[]
}

model Gate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  guards      Guard[]
  entryVisits Visit[]  @relation("entryGate")
  exitVisits  Visit[]  @relation("exitGate")
}

model Visitor {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  permits   Permit[]

  @@index([fullName])
  @@index([phone])
}

model Permit {
  id                  String          @id @default(cuid())
  permitNumber        String          @unique
  qrTokenHash         String          @unique
  residentId          String
  visitorId           String
  purpose             String
  visitDate           DateTime
  visitEndDate        DateTime?
  startTime           String
  endTime             String
  vehicleRegistration String?
  vehicleType         String?
  visitorPhotoUrl     String?
  permitCategory      PermitCategory  @default(STANDARD)
  chargeAmount        Decimal?
  chargeStatus        ChargeStatus?
  status              PermitStatus    @default(APPROVED)
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  resident            Resident        @relation(fields: [residentId], references: [id])
  visitor             Visitor         @relation(fields: [visitorId], references: [id])
  visit               Visit?

  @@index([residentId, visitDate])
  @@index([visitDate, status])
}

model Visit {
  id           String      @id @default(cuid())
  permitId     String      @unique
  status       VisitStatus @default(EXPECTED)
  entryGateId  String?
  exitGateId   String?
  entryGuardId String?
  exitGuardId  String?
  entryAt      DateTime?
  exitAt       DateTime?
  denialReason String?
  denialNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  permit       Permit      @relation(fields: [permitId], references: [id], onDelete: Cascade)
  entryGate    Gate?       @relation("entryGate", fields: [entryGateId], references: [id])
  exitGate     Gate?       @relation("exitGate", fields: [exitGateId], references: [id])
  entryGuard   Guard?      @relation("entryGuard", fields: [entryGuardId], references: [id])
  exitGuard    Guard?      @relation("exitGuard", fields: [exitGuardId], references: [id])

  @@index([status])
  @@index([entryGateId, entryAt])
  @@index([exitGateId, exitAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  guardId    String?
  action     AuditAction
  targetType String
  targetId   String
  gateId     String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  guard      Guard?      @relation(fields: [guardId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model PermitRule {
  id           String   @id @default(cuid())
  name         String
  maxFreeDays  Int      @default(30)
  chargePerDay Decimal?
  currency     String   @default("NGN")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
